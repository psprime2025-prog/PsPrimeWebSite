# ---------------------------------------------------------------------------
# PsPrime — variáveis de ambiente
# Copia este ficheiro para .env.local (desenvolvimento) e preenche os valores reais.
# NUNCA faças commit do .env.local nem de nenhum ficheiro .env com valores reais.
# ---------------------------------------------------------------------------

# URL pública do site (usada em metadados, sitemap, emails, return_url do Stripe)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Base de dados (Supabase Postgres) --------------------------------------
# No Supabase: Project Settings > Database > Connection string
# DATABASE_URL: connection pooling (porta 6543, modo transaction) — usado em runtime
# DIRECT_URL: ligação direta (porta 5432) — usado pelo Prisma Migrate
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# --- Supabase Storage (imagens de produtos) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Stripe -------------------------------------------------------------------
# Dashboard Stripe > Developers > API keys (usa as chaves de teste primeiro, sk_test_/pk_test_)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Dashboard Stripe > Developers > Webhooks > endpoint /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Autenticação de administração (single admin, v1 sem contas de cliente) ---
NEXTAUTH_URL="http://localhost:3000"
# Gera com: openssl rand -base64 32
NEXTAUTH_SECRET=""
ADMIN_EMAIL="suporte@psprime.shop"
# Gera o valor com (já em base64, seguro para colar em qualquer painel de hosting
# — evita que os "$" do hash bcrypt sejam cortados/interpretados como variáveis):
# node -e "console.log(Buffer.from(require('bcryptjs').hashSync('a-tua-password', 10)).toString('base64'))"
ADMIN_PASSWORD_HASH=""

# --- Email transacional (Resend) ----------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="PsPrime <suporte@psprime.shop>"
